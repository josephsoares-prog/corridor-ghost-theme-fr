{{!< default}}

{{#post}}
<article class="article {{post_class}}">
  <div class="wrap">
    <header class="article-head">
      {{#primary_tag}}<a class="ptag" href="{{url}}">{{name}}</a>{{/primary_tag}}
      <h1>{{title}}</h1>
      {{#if custom_excerpt}}<p class="article-excerpt">{{custom_excerpt}}</p>{{/if}}
      <div class="article-meta">
        {{#primary_author}}<a href="{{url}}">{{name}}</a>{{/primary_author}}
        <span>&middot;</span>
        <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="D MMMM YYYY"}}</time>
        <span>&middot;</span>
        <span>{{reading_time}}</span>
      </div>
    </header>
  </div>

  {{#if feature_image}}
    <figure class="feature-image">
      <img src="{{img_url feature_image size="xl"}}"
           srcset="{{img_url feature_image size="m"}} 600w,
                   {{img_url feature_image size="l"}} 1000w,
                   {{img_url feature_image size="xl"}} 2000w"
           sizes="(max-width:1120px) 100vw, 1120px"
           alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}">
      {{#if feature_image_caption}}<figcaption>{{feature_image_caption}}</figcaption>{{/if}}
    </figure>
  {{/if}}

  <div class="wrap">
    <section class="article-body gh-content">
      {{content}}
    </section>

    {{#unless access}}
      <div class="member-cta">
        <div class="eyebrow klabel">R&eacute;serv&eacute; aux abonn&eacute;s</div>
        <div class="h2">Lire la suite &mdash; gratuitement.</div>
        <p>Abonnez-vous au Corridor Intelligence pour lire l&rsquo;analyse compl&egrave;te et recevoir chaque d&eacute;p&ecirc;che dans votre bo&icirc;te de r&eacute;ception.</p>
        {{#unless @member}}
          <a class="btn btn-gold" href="#/portal/signup" data-portal="signup">S&rsquo;abonner gratuitement</a>
        {{else}}
          <a class="btn btn-gold" href="#/portal/account/plans" data-portal="account/plans">Passer au niveau sup&eacute;rieur</a>
        {{/unless}}
      </div>
    {{/unless}}

    <footer class="article-foot">
      {{#if tags}}
        <div class="article-tags">
          {{#foreach tags}}<a href="{{url}}">#{{name}}</a>{{/foreach}}
        </div>
      {{/if}}
      {{#primary_author}}
        <div class="author-box">
          {{#if profile_image}}<img src="{{img_url profile_image size="s"}}" alt="{{name}}">{{/if}}
          <div>
            <div class="an">{{name}}</div>
            {{#if bio}}<div class="ab">{{bio}}</div>{{/if}}
          </div>
        </div>
      {{/primary_author}}
    </footer>
  </div>
</article>

{{#unless @member}}{{> "subscribe"}}{{/unless}}
{{/post}}
