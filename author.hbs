{{!< default}}

{{#author}}
<header class="home-hero" style="padding-bottom:20px">
  <div class="wrap">
    <div class="author-box" style="margin-top:0">
      {{#if profile_image}}<img src="{{img_url profile_image size="m"}}" alt="{{name}}">{{/if}}
      <div>
        <div class="eyebrow">Auteur</div>
        <h1 style="font-size:40px;margin:6px 0">{{name}}</h1>
        {{#if bio}}<p class="ab" style="max-width:56ch">{{bio}}</p>{{/if}}
      </div>
    </div>
  </div>
</header>
{{/author}}

<section class="blk" style="padding-top:30px">
  <div class="wrap">
    <ul class="postfeed">
      {{#foreach posts}}
        {{> "post-card"}}
      {{/foreach}}
    </ul>
    {{pagination}}
  </div>
</section>
