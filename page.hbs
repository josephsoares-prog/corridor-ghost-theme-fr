{{!< default}}

{{#post}}
<article class="article {{post_class}}">
  {{#if @page.show_title_and_feature_image}}
  <div class="wrap">
    <header class="article-head">
      <h1>{{title}}</h1>
      {{#if custom_excerpt}}<p class="article-excerpt">{{custom_excerpt}}</p>{{/if}}
    </header>
  </div>

  {{#if feature_image}}
    <figure class="feature-image">
      <img src="{{img_url feature_image size="xl"}}" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}">
    </figure>
  {{/if}}
  {{/if}}

  <div class="wrap">
    <section class="article-body gh-content">
      {{content}}
    </section>
  </div>
</article>

{{!-- Dedicated /subscribe landing gets the capture block --}}
{{#has slug="subscribe"}}{{> "subscribe"}}{{/has}}
{{/post}}
